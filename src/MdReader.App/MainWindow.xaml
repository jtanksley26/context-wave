<Window x:Class="MdReader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MD Reader" Height="720" Width="900" AllowDrop="True" Drop="OnDrop"
        Background="{DynamicResource PageBrush}">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open..." Click="OnOpenClick" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem x:Name="AnnounceCodeItem" Header="Announce _code blocks"
                          IsCheckable="True" Click="OnAnnounceClick" />
                <Separator />
                <MenuItem x:Name="ThemeMenu" Header="_Theme" />
                <MenuItem x:Name="HighlightMenu" Header="_Highlight colour" />
                <MenuItem x:Name="VisualizerMenu" Header="_Visualiser" />
                <Separator />
                <MenuItem x:Name="RepliesMenu" Header="Claude's _replies" />
            </MenuItem>
        </Menu>

        <Border x:Name="DownloadBanner" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="{DynamicResource BannerBrush}" Padding="10">
            <DockPanel>
                <Button x:Name="DownloadButton" DockPanel.Dock="Right" Content="Download"
                        Padding="12,4" Click="OnDownloadClick" />
                <ProgressBar x:Name="DownloadProgress" DockPanel.Dock="Right" Width="160" Height="14"
                             Margin="0,0,10,0" Maximum="1" Visibility="Collapsed" />
                <TextBlock x:Name="DownloadText" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource BannerTextBrush}" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="10" BorderThickness="0,1,0,0"
                Background="{DynamicResource ChromeBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                TextElement.Foreground="{DynamicResource ChromeTextBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="Previous" Padding="10,4" Click="OnPreviousClick" />
                    <Button x:Name="PlayButton" Content="Play" Padding="10,4" Margin="6,0" MinWidth="64"
                            Click="OnPlayClick" />
                    <Button Content="Next" Padding="10,4" Click="OnNextClick" />
                    <Slider x:Name="SpeedSlider" Width="120" Margin="16,0,6,0" VerticalAlignment="Center"
                            Minimum="0.5" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True"
                            ValueChanged="OnSpeedChanged" />
                    <TextBlock x:Name="SpeedText" Width="36" VerticalAlignment="Center" />
                    <ComboBox x:Name="VoiceBox" Width="210" Margin="10,0,0,0" DisplayMemberPath="Label"
                              SelectionChanged="OnVoiceChanged" />
                </StackPanel>
                <TextBlock x:Name="PositionText" DockPanel.Dock="Right" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Margin="12,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource ErrorTextBrush}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <wv2:WebView2 x:Name="WebView" />
    </DockPanel>
</Window>
