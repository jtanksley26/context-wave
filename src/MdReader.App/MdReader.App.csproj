<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- The name and icon the user sees; the file and assembly names are unchanged. -->
    <Product>Context Wave</Product>
    <AssemblyTitle>Context Wave</AssemblyTitle>
    <ApplicationIcon>../../assets/context-wave.ico</ApplicationIcon>
    <MdReaderOut Condition="'$(MdReaderOut)' == ''">..\..\out\</MdReaderOut>
    <OutputPath>$(MdReaderOut)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MdReader.Core\MdReader.Core.csproj" />
    <ProjectReference Include="..\MdReader.Bridge\MdReader.Bridge.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- Mermaid 12.1.0 (MIT, see Assets/mermaid.LICENSE), injected into the reading pane to draw diagrams. -->
    <EmbeddedResource Include="Assets\mermaid.min.js" LogicalName="mermaid.min.js" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
</Project>
